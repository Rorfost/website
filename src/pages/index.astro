---
import { Image } from 'astro:assets';
import brandIcon from '../assets/rorfost-icon.png';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <Header />
  <main id="main-content">
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Independent software brand</p>
          <h1>Software that stays focused on what matters.</h1>
          <p class="lead">
            {site.tagline} Rorfost brings early-stage projects under one clear, practical
            identity.
          </p>
          <div class="actions">
            <a class="button" href="#projects">Explore our work</a>
            <a
              class="text-link"
              href={site.githubUrl}
              target="_blank"
              rel="noreferrer"
            >
              Visit GitHub <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
        <div class="hero-panel" aria-hidden="true">
          <span class="hero-panel-label">Rorfost</span>
          <div class="hero-icon-frame">
            <Image class="hero-icon" src={brandIcon} alt="" format="webp" />
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="section">
      <div class="shell two-column">
        <p class="eyebrow">About Rorfost</p>
        <div>
          <h2>A home for useful digital work.</h2>
          <p>
            Rorfost is an early-stage, independent software brand. We are
            building a small collection of products, SaaS ideas, and digital
            tools designed to solve real problems clearly and simply.
          </p>
          <p>
            We favour thoughtful scope, reliable foundations, and steady
            improvement over unnecessary complexity.
          </p>
        </div>
      </div>
    </section>

    <section id="projects" class="section section--tint">
      <div class="shell two-column">
        <div>
          <p class="eyebrow">Projects</p>
          <h2>Work in progress, shared honestly.</h2>
        </div>
        {
          site.projects.length > 0 ? (
            <div class="project-list">
              {site.projects.map((project) => (
                <article class="project-card">
                  <span class="status">{project.status}</span>
                  <h3>{project.name}</h3>
                  <p>{project.description}</p>
                  <a
                    class="text-link"
                    href={project.url}
                    target="_blank"
                    rel="noreferrer"
                  >
                    View project <span aria-hidden="true">&rarr;</span>
                  </a>
                </article>
              ))}
            </div>
          ) : (
            <div class="project-empty">
              <span class="status">In progress</span>
              <h3>New projects are taking shape.</h3>
              <p>
                Rorfost is currently developing its first products. Approved
                launches and project links will appear here when they are ready
                to share.
              </p>
              <a
                class="text-link"
                href={site.githubUrl}
                target="_blank"
                rel="noreferrer"
              >
                Follow our work on GitHub <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          )
        }
      </div>
    </section>

    <section id="contact" class="section contact-section">
      <div class="shell contact-card">
        <div>
          <p class="eyebrow">Contact</p>
          <h2>Keep up with Rorfost.</h2>
          <p>
            For now, the best place to follow current work is the Rorfost GitHub
            organisation.
          </p>
        </div>
        <a
          class="button button--light"
          href={site.githubUrl}
          target="_blank"
          rel="noreferrer"
        >
          Open GitHub <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
