{
  "name": "rorfost-website",
  "version": "0.1.0",
  "private": true,
  "description": "Public website for Rorfost.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "astro check",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "preview:production": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "test": "playwright test",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.6.3",
    "astro": "^7.3.5",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.142.0"
  }
}
